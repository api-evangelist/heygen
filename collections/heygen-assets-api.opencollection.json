{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyGen Account Assets API",
    "version": "4.0.8"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload Asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.heygen.com/v1/asset",
            "headers": [
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Uploads a media file (image, video, or audio) to the authenticated user's HeyGen account and returns the asset ID for future use."
        }
      ]
    }
  ],
  "bundled": true
}