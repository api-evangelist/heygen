        {
          "info": {
            "name": "List Streaming Avatars",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.heygen.com/v1/streaming/avatar.list",
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "This API endpoint allows you to retrieve a list of public and custom interactive avatars."
