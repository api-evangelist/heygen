{
  "opencollection": "1.0.0",
  "info": {
    "name": "HeyGen Account Streaming API",
    "version": "4.0.8"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Streaming",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send Task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.heygen.com/v1/streaming.task",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint is used to send a text to an Interactive Avatar, prompting it to speak the provided text."
        },
        {
          "info": {
            "name": "Close Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.heygen.com/v1/streaming.stop",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint is used to terminate an active streaming session."
        },
        {
          "info": {
            "name": "Start Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.heygen.com/v1/streaming.start",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
